<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}art2-rue{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🎨</text></svg>">

    {% block stylesheets %}
        <style>
            body { font-family: sans-serif; margin: 0; }
            nav a { margin-left: 1rem; }
        </style>
    {% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body>
<header style="display:flex; justify-content:space-between; align-items:center; padding:1rem 2rem; border-bottom:1px solid #ddd;">
    <a href="{{ path('app_home') }}" style="font-size:1.5rem; font-weight:bold; text-decoration:none; color:inherit;">art2-rue</a>

    <nav>
        <a href="{{ path('app_oeuvre_index') }}">Les œuvres</a>
        {% if is_granted('IS_AUTHENTICATED') %}
            <a href="{{ path('app_logout') }}">Déconnexion</a>
        {% else %}
            <a href="{{ path('app_login') }}">Connexion</a>
        {% endif %}
    </nav>
</header>

<main style="padding:2rem;">
    {% block body %}{% endblock %}
</main>
</body>
</html>
