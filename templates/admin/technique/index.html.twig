{% extends 'base.html.twig' %}

{% block title %}Techniques{% endblock %}

{% block body %}
    <h1>Techniques</h1>

    <table class="table table-striped">
        <thead>
        <tr>
            <th>Nom</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        {% for technique in techniques %}
            <tr>
                <td>{{ technique.nom }}</td>
                <td>
                    <a class="btn btn-warning btn-sm" href="{{ path('app_admin_technique_edit', {'id': technique.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="2">Aucune technique</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a class="btn btn-primary" href="{{ path('app_admin_technique_new') }}">Ajouter une technique</a>
{% endblock %}
