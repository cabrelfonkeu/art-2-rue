<hr>
<h2>Supprimer le bénévole</h2>
<p class="alert alert-danger">Attention, cette action ne peut pas être annulée</p>
<form method="post" action="{{ path('app_admin_benevole_delete', {'id': benevole.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ benevole.id) }}">
    <button class="btn btn-danger">Supprimer</button>
</form>
