{% extends 'base.html.twig' %}

{% block title %}Artistes{% endblock %}

{% block body %}
    <h1>Artistes</h1>

    <table class="table table-striped">
        <thead>
        <tr>
            <th>Pseudonyme</th>
            <th>Nom réel</th>
            <th>Nationalité</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        {% for artiste in artistes %}
            <tr>
                <td>{{ artiste.pseudonyme }}</td>
                <td>{{ artiste.nomreel }}</td>
                <td>{{ artiste.nationalite }}</td>
                <td>
                    <a class="btn btn-warning btn-sm" href="{{ path('app_admin_artiste_edit', {'id': artiste.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">Aucun artiste</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a class="btn btn-primary" href="{{ path('app_admin_artiste_new') }}">Ajouter un artiste</a>
{% endblock %}
