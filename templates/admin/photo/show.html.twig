{% extends 'base.html.twig' %}

{% block title %}Photo{% endblock %}

{% block body %}
    <h1>Photo</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ photo.id }}</td>
            </tr>
            <tr>
                <th>Dateprisevue</th>
                <td>{{ photo.dateprisevue ? photo.dateprisevue|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Nomfichier</th>
                <td>{{ photo.nomfichier }}</td>
            </tr>
            <tr>
                <th>Etatoeuvre</th>
                <td>{{ photo.etatoeuvre }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_admin_photo_index') }}">back to list</a>

    <a href="{{ path('app_admin_photo_edit', {'id': photo.id}) }}">edit</a>

    {{ include('admin/photo/_delete_form.html.twig') }}
{% endblock %}
